# ──────────────────────────────────────────────────────────────────────────────
# GLOBAL BRIDGES NETWORK — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── SMTP Configuration ────────────────────────────────────────────────────────
# Your outgoing mail server settings (Gmail, Outlook, cPanel, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Sanity CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty locally to skip tracking.
NEXT_PUBLIC_GA_ID=

# ── Newsletter (Brevo) ────────────────────────────────────────────────────────
# Brevo → Settings → SMTP & API → API Keys (server-only; never NEXT_PUBLIC_)
BREVO_API_KEY=
# Brevo → Contacts → Lists → the newsletter list's ID number
BREVO_LIST_ID=
