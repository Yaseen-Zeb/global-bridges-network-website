# ──────────────────────────────────────────────────────────────────────────────
# BRIDGE GLOBAL NETWORK — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── SMTP Configuration ────────────────────────────────────────────────────────
# Your outgoing mail server settings (Gmail, Outlook, cPanel, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Recipient Email Addresses ─────────────────────────────────────────────────
# Who receives the Contact Us form submissions
CONTACT_RECIPIENT_EMAIL=

# Who receives the Donate Goods form submissions
DONATE_GOODS_RECIPIENT_EMAIL=


# ── Sanity CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
