# Next.js Frontend — Sanity Environment Variables
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* variables are safe to expose to the browser.
# Never prefix SANITY_API_TOKEN with NEXT_PUBLIC_.

# Your Sanity project ID (must match backend/.env)
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR_PROJECT_ID

# Dataset name (must match backend/.env) — default: "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only API token — for fetching draft/preview content in Server Components.
# Create at: sanity.io/manage → API → Tokens → Add API Token (Viewer role is enough)
# This value is NEVER sent to the browser.
SANITY_API_TOKEN=
